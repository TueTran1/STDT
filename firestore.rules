rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================
    // HELPER FUNCTIONS - Firebase Auth Integration
    // ========================================
    
    // Check if user is authenticated via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Get user role from Firestore users collection using Firebase Auth UID
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    // Check if user is active in Firestore
    function isUserActive() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }
    
    // Check if user is admin (role from Firestore) - Free Plan compatible
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }
    
    // Allow user creation if authenticated user is creating the document
    // This works because we validate admin role in the frontend code
    function canCreateUser() {
      return isAuthenticated() && 
             request.resource.data.createdBy == request.auth.uid;
    }
    
    // Check if user is editor (role from Firestore) - Free Plan compatible
    function isEditor() {
      return isAuthenticated() && getUserRole() == 'editor';
    }
    
    // Check if user owns the resource (Firebase Auth UID match)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ========================================
    // USERS COLLECTION - Firebase Auth Integration
    // ========================================
    
    match /users/{userId} {
      // Allow read for authenticated users reading their own profile
      allow read: if isAuthenticated() && request.auth.uid == userId;
      
      // Allow read for login queries (findUserForLogin) - both authenticated and unauthenticated
      allow read: if true;
      
      // Users can update their own profile (except role, isActive, uid)
      allow update: if isOwner(userId) && 
        get(/databases/$(database)/documents/users/$(userId)).data.isActive == true;
      
      // Admins can update any user profile (via Firestore role or custom claims)
      allow update: if isAdmin();
      
      // Only admins can create users (with special case handling)
      allow create: if canCreateUser();
      
      // Only admins can delete users (via Firestore role or custom claims)
      allow delete: if isAdmin();
    }

    // Allow list queries for login purposes and admin access
    match /users {
      // Allow list for all queries during login and admin access
      allow list, get: if true;
    }

    // ========================================
    // KNOWLEDGE COLLECTION - Simplified Rules
    // ========================================
    
    match /knowledge/{knowledgeId} {
      // Public read access for published articles
      allow read: if resource.data.status == 'published';
      
      // Editor read access for their own saved articles
      allow read: if isAuthenticated() && 
        (resource.data.status == 'published' || resource.data.createdBy == request.auth.uid);
      
      // Admin read access for all articles
      allow read: if isAdmin();
      
      // Editor create permissions
      allow create: if isAuthenticated() && 
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.author.uid == request.auth.uid;
      
      // Editor update permissions
      allow update: if isAuthenticated() && 
        resource.data.createdBy == request.auth.uid;
      
      // Admin delete permissions
      allow delete: if isAdmin();
    }

    // Knowledge Collection - Enhanced List access with proper query support
    match /knowledge {
      // Allow list for published knowledge (public access)
      allow list: if true;
      
      // Allow list for editors to access their own saved articles (both createdBy and author.uid)
      // Support queries with orderBy for sorting
      allow list: if isAuthenticated() && 
        request.query.where.length >= 2 &&
        request.query.where[0] == ['status', '==', 'saved'] &&
        (request.query.where[1] == ['createdBy', '==', request.auth.uid] || 
         request.query.where[1] == ['author.uid', '==', request.auth.uid]) &&
        (request.query.orderBy == null || 
         request.query.orderBy[0] == ['createdAt', 'desc']);
      
      // Allow list for admins to access all knowledge
      allow list: if isAdmin();
      
      // Allow get for individual documents (handled by /knowledge/{knowledgeId} rule)
      allow get: if false;
    }

    // ========================================
    // NEWS COLLECTION - Simplified Rules
    // ========================================
    
    match /news/{newsId} {
      // Public read access for published articles
      allow read: if resource.data.status == 'published';
      
      // Editor read access for their own saved articles
      allow read: if isAuthenticated() && 
        (resource.data.status == 'published' || resource.data.createdBy == request.auth.uid);
      
      // Admin read access for all articles
      allow read: if isAdmin();
      
      // Editor create permissions
      allow create: if isAuthenticated() && 
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.author.uid == request.auth.uid;
      
      // Editor update permissions
      allow update: if isAuthenticated() && 
        resource.data.createdBy == request.auth.uid;
      
      // Admin delete permissions
      allow delete: if isAdmin();
    }

    // News Collection - Enhanced List access with proper query support
    match /news {
      // Allow list for published news (public access)
      allow list: if true;
      
      // Allow list for editors to access their own saved articles (both createdBy and author.uid)
      // Support queries with orderBy for sorting
      allow list: if isAuthenticated() && 
        request.query.where.length >= 2 &&
        request.query.where[0] == ['status', '==', 'saved'] &&
        (request.query.where[1] == ['createdBy', '==', request.auth.uid] || 
         request.query.where[1] == ['author.uid', '==', request.auth.uid]) &&
        (request.query.orderBy == null || 
         request.query.orderBy[0] == ['createdAt', 'desc']);
      
      // Allow list for admins to access all news
      allow list: if isAuthenticated() && getUserRole() == 'admin';
      
      // Allow get for individual documents (handled by /news/{newsId} rule)
      allow get: if false;
    }

    // ========================================
    // OTHER COLLECTIONS - Basic Rules
    // ========================================
    
    // Traditions Collection
    match /traditions/{traditionId} {
      // Public read for published traditions
      allow read: if resource.data.status == 'published';
      
      // Authenticated users can read their own drafts
      allow read: if isAuthenticated() && resource.data.contributor.uid == request.auth.uid;
      
      // Admins can read all traditions
      allow read: if isAdmin();
      
      // Admins can create, update, delete any traditions
      allow create, update, delete: if isAdmin();
    }

    match /traditions {
      // Allow list for published traditions (public access)
      allow list: if true;
      allow get: if false;
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isAuthenticated() && resource.data.recipientUid == request.auth.uid;
      
      // Admins can read all notifications
      allow read: if isAdmin();
      
      // Admins can create, update, delete any notifications
      allow create, update, delete: if isAdmin();
    }

    // User-specific subcollections
    match /users/{userId}/{subcollection=**} {
      // Users can only access their own subcollections if active
      allow read, write: if isAuthenticated() && 
        request.auth.uid == userId &&
        get(/databases/$(database)/documents/users/$(userId)).data.isActive == true;
      
      // Admins can access any user subcollections
      allow read, write: if isAdmin();
    }

    // Comments subcollection
    match /{collection}/{docId}/comments/{commentId} {
      // Public read for active comments on published content
      allow read: if resource.data.status == 'active' && 
        resource.data.status == 'published';
      
      // Authenticated users can create comments
      allow create: if isAuthenticated();
      
      // Users can update their own comments
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid;
      
      // Users can delete their own comments
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
      
      // Admins can manage any comment
      allow read, update, delete: if isAdmin();
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
