rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================
    // HELPER FUNCTIONS - Firebase Auth Integration
    // ========================================
    
    // Check if user is authenticated via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Get user role from Firestore users collection using Firebase Auth UID
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    // Check if user is active in Firestore
    function isUserActive() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }
    
    // Check if user is admin (role from Firestore)
    function isAdmin() {
      return isAuthenticated() && isUserActive() && getUserRole() == 'admin';
    }
    
    // Check if user is editor (role from Firestore)
    function isEditor() {
      return isAuthenticated() && isUserActive() && getUserRole() == 'editor';
    }
    
    // Check if user owns the resource (Firebase Auth UID match)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Check if user is the article author (createdBy or author.uid)
    function isArticleOwner(articleData) {
      return isAuthenticated() && 
        (request.auth.uid == articleData.createdBy || 
         request.auth.uid == articleData.author.uid);
    }
    
    // Prevent UID spoofing - ensure createdBy matches authenticated user
    function isValidCreatedBy() {
      return request.resource.data.createdBy == request.auth.uid;
    }
    
    // Prevent author.uid spoofing
    function isValidAuthorUid() {
      return request.resource.data.author.uid == request.auth.uid;
    }

    // ========================================
    // USERS COLLECTION - Firebase Auth Integration
    // ========================================
    
    match /users/{userId} {
      // Allow read for authenticated users reading their own profile
      allow read: if isAuthenticated() && request.auth.uid == userId;
      
      // Allow read for login queries (findUserForLogin) - both authenticated and unauthenticated
      // This allows querying by email/displayName during login process
      allow read: if true;
      
      // Users can update their own profile (except role, isActive, uid)
      // Firebase Auth UID must match document userId
      allow update: if isOwner(userId) && isUserActive() &&
        get(/databases/$(database)/documents/users/$(userId)).data.isActive == true &&
        request.resource.data.keys().hasAll(['displayName', 'profile', 'preferences']) &&
        !request.resource.data.keys().hasAny(['role', 'isActive', 'uid', 'email', 'passwordHash']);
      
      // Admins can update any user profile
      allow update: if isAdmin();
      
      // Only admins can create users
      allow create: if isAdmin();
      
      // Only admins can delete users
      allow delete: if isAdmin();
    }

    // Allow list queries for login purposes and admin access
    match /users {
      // Allow list for all queries during login and admin access
      allow list, get: if true;
    }

    // ========================================
    // NEWS COLLECTION - Firebase Auth Integration
    // ========================================
    
    // NEWS DOCUMENT ACCESS RULES:
    // 1. Public users can read published articles only
    // 2. Editors can read published content + their own saved content
    // 3. Admins can read all content
    // 4. Editors can create and update their own articles (cannot delete)
    // 5. Admins can delete any content (cannot create/update)
    // 6. Firebase Auth UID prevents spoofing
    // 7. User must be active in Firestore
    
    match /news/{newsId} {
      // Public read access for published articles
      // No authentication required for public content
      allow read: if resource.data.status == 'published';
      
      // Editor read access for their own saved articles
      // Editors can read published content + their own drafts/saved articles
      allow read: if isEditor() && 
        (resource.data.status == 'published' || isArticleOwner(resource.data));
      
      // Admin read access for all articles
      // Admins have full read access to all content
      allow read: if isAdmin();
      
      // Editor create permissions (cannot delete)
      // Editors can create articles with their Firebase Auth UID
      allow create: if isEditor() && isValidCreatedBy() && isValidAuthorUid();
      
      // Editor update permissions (cannot delete)
      // Editors can update their own articles, createdBy is immutable
      allow update: if isEditor() && 
        isArticleOwner(resource.data) &&
        request.resource.data.createdBy == resource.data.createdBy && // createdBy immutable
        request.resource.data.author.uid == resource.data.author.uid; // author.uid immutable
      
      // Admin delete permissions (cannot create/update)
      // Only admins can delete articles
      allow delete: if isAdmin();
    }

    // News Collection - List access
    match /news {
      // Allow list for all users - individual document permissions will apply
      // This enables public access to published articles while restricting others
      allow list: if true;
      
      // Allow get for individual documents (handled by /news/{newsId} rule)
      allow get: if false;
    }

    // Traditions Collection - Basic access control
    match /traditions/{traditionId} {
      // Public read for published traditions (no auth required)
      allow read: if resource.data.status == 'published';
      
      // Authenticated users can read their own drafts
      allow read: if isAuthenticated() && resource.data.contributor.uid == request.auth.uid;
      
      // Admins can read all traditions
      allow read: if isAdmin();
      
      // Admins can create, update, delete any traditions
      allow create, update, delete: if isAdmin();
    }

    // Traditions Collection - List access
    match /traditions {
      // Allow list for published traditions (public access)
      allow list: if true;
      
      // Allow get for individual documents (handled by /traditions/{traditionId} rule)
      allow get: if false;
    }

    // ========================================
    // KNOWLEDGE COLLECTION - Firebase Auth Integration
    // ========================================
    
    // KNOWLEDGE DOCUMENT ACCESS RULES:
    // 1. Public users can read published articles only
    // 2. Editors can read published content + their own saved content
    // 3. Admins can read all content
    // 4. Editors can create and update their own articles (cannot delete)
    // 5. Admins can delete any content (cannot create/update)
    // 6. Firebase Auth UID prevents spoofing
    // 7. User must be active in Firestore
    
    match /knowledge/{knowledgeId} {
      // Public read access for published articles
      // No authentication required for public content
      allow read: if resource.data.status == 'published';
      
      // Editor read access for their own saved articles
      // Editors can read published content + their own drafts/saved articles
      allow read: if isEditor() && 
        (resource.data.status == 'published' || isArticleOwner(resource.data));
      
      // Admin read access for all articles
      // Admins have full read access to all content
      allow read: if isAdmin();
      
      // Editor create permissions (cannot delete)
      // Editors can create articles with their Firebase Auth UID
      allow create: if isEditor() && isValidCreatedBy() && isValidAuthorUid();
      
      // Editor update permissions (cannot delete)
      // Editors can update their own articles, createdBy is immutable
      allow update: if isEditor() && 
        isArticleOwner(resource.data) &&
        request.resource.data.createdBy == resource.data.createdBy && // createdBy immutable
        request.resource.data.author.uid == resource.data.author.uid; // author.uid immutable
      
      // Admin delete permissions (cannot create/update)
      // Only admins can delete articles
      allow delete: if isAdmin();
    }

    // Knowledge Collection - List access
    match /knowledge {
      // Allow list for published knowledge (public access)
      allow list: if true;
      
      // Allow get for individual documents (handled by /knowledge/{knowledgeId} rule)
      allow get: if false;
    }

    // Notifications Collection - User-specific access
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isAuthenticated() && resource.data.recipientUid == request.auth.uid;
      
      // Admins can read all notifications
      allow read: if isAdmin();
      
      // Admins can create, update, delete any notifications
      allow create, update, delete: if isAdmin();
    }

    // User-specific subcollections
    match /users/{userId}/{subcollection=**} {
      // Users can only access their own subcollections if active
      allow read, write: if isAuthenticated() && 
        request.auth.uid == userId &&
        get(/databases/$(database)/documents/users/$(userId)).data.isActive == true;
      
      // Admins can access any user subcollections
      allow read, write: if isAdmin();
    }

    // Comments subcollection - Basic moderation
    match /{collection}/{docId}/comments/{commentId} {
      // Public read for active comments on published content
      allow read: if resource.data.status == 'active' && 
        get(/databases/$(database)/documents/$(collection)/$(docId)).data.status == 'published';
      
      // Authenticated users can create comments
      allow create: if isAuthenticated();
      
      // Users can update their own comments
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid;
      
      // Users can delete their own comments
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
      
      // Admins can manage any comment
      allow read, update, delete: if isAdmin();
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
